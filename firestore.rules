rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function owner(patientId) {
      return request.auth != null && request.auth.uid == patientId;
    }
    function validMedication(patientId) {
      let data = request.resource.data;
      return data.patientId == patientId
        && data.name is string && data.name.size() > 0
        && data.strength is string && data.strength.size() > 0
        && data.dose is string && data.dose.size() > 0
        && data.frequency is string && data.frequency.size() > 0
        && data.reminderTimes is list && data.reminderTimes.size() > 0
        && data.active is bool;
    }
    function caregiverCan(patientId, permission) {
      let path = /databases/$(database)/documents/users/$(patientId)/medicationCaregivers/$(request.auth.uid);
      return request.auth != null && exists(path)
        && get(path).data.revoked == false
        && get(path).data.permissions.hasAll(['VIEW', permission]);
    }
    match /users/{patientId}/medicationCaregivers/{caregiverId} {
      allow read: if owner(patientId) || (request.auth != null && request.auth.uid == caregiverId);
      allow create, update: if owner(patientId) && caregiverId != patientId
        && exists(/databases/$(database)/documents/users/$(caregiverId))
        && request.resource.data.keys().hasOnly(['patientId', 'caregiverId', 'patientName', 'permissions', 'revoked'])
        && request.resource.data.patientId == patientId && request.resource.data.caregiverId == caregiverId
        && request.resource.data.patientName is string && request.resource.data.patientName.size() <= 200
        && request.resource.data.revoked is bool
        && request.resource.data.permissions is list
        && request.resource.data.permissions.hasOnly(['VIEW', 'EDIT'])
        && (!request.resource.data.permissions.hasAny(['EDIT']) || request.resource.data.permissions.hasAny(['VIEW']));
      allow delete: if owner(patientId);
    }
    match /users/{patientId}/medications/{medicationId} {
      allow read: if owner(patientId) || caregiverCan(patientId, 'VIEW');
      allow delete: if owner(patientId);
      allow create: if owner(patientId) && validMedication(patientId);
      allow update: if validMedication(patientId) && (owner(patientId) || (
        caregiverCan(patientId, 'EDIT')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'strength', 'dose', 'frequency', 'reminderTimes', 'instructions', 'updatedById', 'updatedAt'])
        && request.resource.data.updatedById == request.auth.uid
        && request.resource.data.updatedAt == request.time
      ));
    }
    match /users/{patientId}/doseRecords/{doseId} {
      allow read: if owner(patientId);
      allow create, update: if owner(patientId)
        && request.resource.data.keys().hasOnly(['medicationId', 'scheduledTimeMillis', 'status', 'completionTimeMillis'])
        && request.resource.data.medicationId is string
        && exists(/databases/$(database)/documents/users/$(patientId)/medications/$(request.resource.data.medicationId))
        && request.resource.data.scheduledTimeMillis is int && request.resource.data.scheduledTimeMillis > 0
        && request.resource.data.status in ['taken', 'skipped', 'missed', 'delayed']
        && request.resource.data.completionTimeMillis is int && request.resource.data.completionTimeMillis > 0;
      allow delete: if owner(patientId);
    }
    // Collection-group discovery exposes only the signed-in caregiver's own grants.
    // Record access continues to be checked by the medication rules above.
    match /{path=**}/medicationCaregivers/{grantId} {
      allow list: if request.auth != null && resource.data.caregiverId == request.auth.uid;
    }
    // Profiles remain private to their owner, matching the published rules.
    match /users/{userId} {
      allow read, create, update: if owner(userId);
      match /{collection}/{documentId} {
        allow read, delete: if owner(userId)
          && collection in ['appointments', 'healthConcerns', 'careTasks'];
        allow create, update: if owner(userId)
          && collection in ['appointments', 'healthConcerns', 'careTasks']
          && request.resource.data.patientId == userId;
      }
    }
    // Preserve access to legacy top-level care tasks shown in the published rules.
    match /careTasks/{taskId} {
      allow read, delete: if request.auth != null
        && resource.data.patientId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.patientId == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.patientId == request.auth.uid
        && request.resource.data.patientId == resource.data.patientId;
    }
  }
}
